# Revalidate the shell and PWA metadata after each Cloudflare Pages deployment.
# Vite's content-hashed assets can use Cloudflare Pages default caching.
/
  Cache-Control: no-cache, max-age=0, must-revalidate
/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate
/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: no-cache, max-age=0, must-revalidate
